{
  "name": "livpbp",
  "version": "1.0.0",
  "private": true,
  "description": "Static official-source MLB scoreboard, game and replay feed",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server.mjs",
    "build": "node tools/build.mjs",
    "check": "node tools/check.mjs",
    "test": "node --test tools/unit.test.mjs tools/server.test.mjs",
    "test:browser": "node tools/browser-test.mjs",
    "test:live": "node tools/live-smoke.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "playwright-core": "1.65.1"
  }
}
